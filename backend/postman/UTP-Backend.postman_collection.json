{
  "info": {
    "name": "UTP Backend (Spring Boot + MySQL + JWT)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "1) Ejecuta los 3 logins (guardan el token). 2) Prueba el resto. En 'Subir material' elige un archivo en el campo 'archivo'."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenAlumno",
      "value": ""
    },
    {
      "key": "tokenDocente",
      "value": ""
    },
    {
      "key": "tokenJefatura",
      "value": ""
    },
    {
      "key": "recursoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login alumno",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alumno@utp.edu\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.collectionVariables.set('tokenAlumno', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login docente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"docente@utp.edu\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.collectionVariables.set('tokenDocente', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login jefatura (UTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jefatura@utp.edu\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.collectionVariables.set('tokenJefatura', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login inválido (espera 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"x@x.cl\",\n  \"password\": \"mal\"\n}"
            }
          }
        },
        {
          "name": "Sin token (espera 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/unidades"
            }
          }
        }
      ]
    },
    {
      "name": "2. Unidades",
      "item": [
        {
          "name": "Listar unidades",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/unidades"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlumno}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Crear unidad (docente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/unidades"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asignatura\": \"MATEMATICAS\",\n  \"numero\": 9,\n  \"titulo\": \"Unidad nueva\",\n  \"descripcion\": \"Prueba\",\n  \"estado\": \"PENDIENTE\",\n  \"modificadoPor\": \"Docente\"\n}"
            }
          }
        },
        {
          "name": "Aprobar unidad (jefatura)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/unidades/1/estado"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenJefatura}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"APROBADO\",\n  \"observaciones\": \"OK\",\n  \"usuario\": \"Jefe UTP\"\n}"
            }
          }
        },
        {
          "name": "Aprobar unidad como alumno (espera 403)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/unidades/1/estado"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlumno}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"APROBADO\",\n  \"observaciones\": \"\",\n  \"usuario\": \"x\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Material",
      "item": [
        {
          "name": "Subir material (docente → PENDIENTE)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recursos"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "titulo",
                  "value": "Guía de sumas",
                  "type": "text"
                },
                {
                  "key": "descripcion",
                  "value": "Ejercicios",
                  "type": "text"
                },
                {
                  "key": "asignatura",
                  "value": "MATEMATICAS",
                  "type": "text"
                },
                {
                  "key": "unidadId",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "archivo",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Subir material (jefatura → APROBADO)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recursos"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenJefatura}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "titulo",
                  "value": "Guía de sumas",
                  "type": "text"
                },
                {
                  "key": "descripcion",
                  "value": "Ejercicios",
                  "type": "text"
                },
                {
                  "key": "asignatura",
                  "value": "MATEMATICAS",
                  "type": "text"
                },
                {
                  "key": "unidadId",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "archivo",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Listar material (docente: el suyo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recursos"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Listar pendientes (jefatura)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recursos?estado=PENDIENTE"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenJefatura}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Autorizar material (jefatura)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recursos/{{recursoId}}/estado"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenJefatura}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"APROBADO\",\n  \"observaciones\": \"\"\n}"
            }
          }
        },
        {
          "name": "Rechazar material (jefatura)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recursos/{{recursoId}}/estado"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenJefatura}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"RECHAZADO\",\n  \"observaciones\": \"Falta calidad\"\n}"
            }
          }
        },
        {
          "name": "Listar material autorizado (alumno)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recursos"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlumno}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Descargar archivo (alumno)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recursos/{{recursoId}}/archivo"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlumno}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Docente intenta autorizar (espera 403)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recursos/{{recursoId}}/estado"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"APROBADO\",\n  \"observaciones\": \"\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Avance y evaluaciones",
      "item": [
        {
          "name": "Mi avance (alumno)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/progreso/mio"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlumno}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Marcar material como visto",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/progreso/recursos/{{recursoId}}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlumno}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Preguntas de la unidad 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/evaluaciones/1/preguntas"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlumno}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Responder evaluación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/evaluaciones/1/responder"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlumno}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"respuestas\": [\n    {\n      \"preguntaId\": 1,\n      \"opcion\": 0\n    },\n    {\n      \"preguntaId\": 2,\n      \"opcion\": 0\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Mis resultados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/evaluaciones/mis-resultados"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlumno}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Crear pregunta (docente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/unidades/1/preguntas"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enunciado\": \"¿2+2?\",\n  \"opciones\": [\n    \"3\",\n    \"4\",\n    \"5\"\n  ],\n  \"correcta\": 1\n}"
            }
          }
        },
        {
          "name": "Avance de todos los alumnos (docente)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/progreso/alumnos"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenDocente}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
