    {
      "name": "Panel",
      "item": [
        {
          "name": "Listar tareas (alumno)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tareas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tareas"
              ]
            }
          }
        },
        {
          "name": "Listar clases (docente)",
          "request": {
            "method": "GET",
            "header": [],
