    },
    {
      "name": "Unidades",
      "item": [
        {
          "name": "Listar unidades",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/unidades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "unidades"
              ]
            }
          }
        },
        {
          "name": "Filtrar por asignatura y estado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/unidades?asignatura=MATEMATICAS&estado=APROBADO",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "unidades"
              ],
              "query": [
                {
                  "key": "asignatura",
                  "value": "MATEMATICAS",
                  "disabled": true
                },
                {
                  "key": "estado",
                  "value": "APROBADO",
                  "disabled": true
                }
              ]
            },
            "description": "Activa los parámetros en la pestaña Params. Asignaturas: LENGUAJE, MATEMATICAS, CIENCIAS, HISTORIA. Estados: BORRADOR, PENDIENTE, APROBADO, RECHAZADO, PUBLICADO, DESHABILITADO."
          }
        },
        {
          "name": "Obtener unidad por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/unidades/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "unidades",
                "1"
              ]
            }
          }
        },
        {
          "name": "Crear unidad",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/unidades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "unidades"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asignatura\": \"LENGUAJE\",\n  \"numero\": 2,\n  \"titulo\": \"Lectura de sílabas\",\n  \"descripcion\": \"Reconocimiento de sílabas directas.\",\n  \"estado\": \"PENDIENTE\",\n  \"modificadoPor\": \"Docente 1° Básico\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Aprobar unidad (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/unidades/1/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "unidades",
                "1",
                "estado"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"APROBADO\",\n  \"observaciones\": \"Cumple con los objetivos\",\n  \"usuario\": \"Jefatura UTP\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Rechazar unidad (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/unidades/1/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "unidades",
                "1",
                "estado"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"RECHAZADO\",\n  \"observaciones\": \"Falta detallar actividades\",\n  \"usuario\": \"Jefatura UTP\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "PUT y PATCH hacen lo mismo; la app Android usa PUT."
          }
        }
      ]
    },
    {
